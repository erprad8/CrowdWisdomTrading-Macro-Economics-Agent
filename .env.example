# --- Apify (macro calendar scraping) ---
APIFY_TOKEN=your_apify_token
# Any ForexFactory-calendar actor works; the normaliser tolerates different field names.
# Candidates found on the Apify Store (verify input schema in the actor's "Input" tab):
#   scrapemint/forexfactory-economic-calendar   (date range input)
#   bovi/forex-economic-calendar-scraper
#   xtracto/forexfactory-calendar
APIFY_ACTOR_ID=scrapemint/forexfactory-economic-calendar
# Input template. {start} and {end} are replaced with YYYY-MM-DD. EDIT KEYS TO MATCH THE ACTOR'S INPUT SCHEMA.
APIFY_INPUT_JSON={"startDate": "{start}", "endDate": "{end}"}

# --- Tavily (recent macro news) ---
TAVILY_API_KEY=your_tavily_key

LOOKBACK_DAYS=180
ANTHROPIC_API_KEY=your_anthropic_key
